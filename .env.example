# Owner composition is fail-closed until ALL separately approved values exist.
# These are placeholders, not activation authorization or operational defaults.
# HAMDEE_MODE and commented TASK005/006 entries are unused historical references;
# the uncommented owner configuration below lists the current consumed fields.
HAMDEE_MODE=
# Never copy another application's .env or set a test-auth deployment flag.

# TASK 005: original integration reference; only the complete owner configuration
# below is consumed, with explicit approval and dedicated project/local DB pins.
# Values must come from the separately approved HAMDEE environment/secret store.
# HAMDEE_APP_ID=
# HAMDEE_ENVIRONMENT=
# HAMDEE_SUPABASE_URL=
# HAMDEE_AUTH_ISSUER=
# HAMDEE_AUTH_AUDIENCE=
# HAMDEE_SUPABASE_PUBLISHABLE_KEY=
# HAMDEE_DATABASE_URL=
# HAMDEE_STORAGE_BUCKET=
# HAMDEE_SESSION_SECRET=
# HAMDEE_SUPABASE_ADMIN_KEY=  # Later approved invitation job ONLY, never property API
# Native suite accepts only explicitly opted-in disposable local connection:
# HAMDEE_NATIVE_TEST_URL=
# HAMDEE_NATIVE_TEST_CONFIRM=

# TASK 006 configuration review references; owner composition consumes the
# approved owner/region/residency fields only with all other required pins.
# HAMDEE_PROJECT_OWNER=
# HAMDEE_REGION=
# HAMDEE_RESIDENCY_DECISION=
# HAMDEE_DATABASE_TLS=  # Future remote contract requires verify-full, never no-verify
# HAMDEE_SESSION_TRANSPORT=  # Must match separately reviewed bearer/server_cookie choice

# Single-owner local CRM candidate. No hosted access/account/recovery messaging
# is authorized now. Do not fill this file with credentials or real identities.
# Owner runtime requires approval string approved-development-owner-runtime;
# it never accepts test-auth/fake-provider flags or generic DATABASE_URL.
HAMDEE_OWNER_RUNTIME_APPROVAL=
HAMDEE_APP_ID=
HAMDEE_ENVIRONMENT=
HAMDEE_DATA_CLASS=
HAMDEE_PROJECT_REF=
HAMDEE_PROJECT_OWNER=
HAMDEE_REGION=
HAMDEE_RESIDENCY_DECISION=
HAMDEE_SUPABASE_URL=
HAMDEE_AUTH_ISSUER=
HAMDEE_AUTH_AUDIENCE=
HAMDEE_SUPABASE_PUBLISHABLE_KEY=
# Immutable provider user UUID, never an email/client role.
HAMDEE_OWNER_SUBJECT=
# Exact approved confirmed owner mailbox; checked alongside immutable UUID.
HAMDEE_OWNER_EMAIL=
HAMDEE_OWNER_ORIGIN=
# Local mode uses dedicated loopback hamdee_dev_* DB only.
HAMDEE_DATABASE_URL=
# Hosted development additionally requires reviewed source pins and Vercel
# Preview scope. No real connection is approved or populated in this template.
HAMDEE_DATABASE_MODE=
HAMDEE_HOSTED_DATABASE_APPROVAL=
HAMDEE_DATABASE_CA_PEM=
#32 random bytes encoded canonical base64url, server-held; never NEXT_PUBLIC_.
HAMDEE_OWNER_COOKIE_KEY=
# All policies are explicit integer milliseconds, except RATE_BOUNDS=count.
# Real runtime requires owner-approved 15-minute idle and 8-hour absolute limits.
# No MFA enrollment, OTP or factor-freshness setting is consumed.
HAMDEE_OWNER_IDLE_MS=
HAMDEE_OWNER_ABSOLUTE_MS=
HAMDEE_OWNER_CSRF_MS=
HAMDEE_OWNER_AUTH_TIMEOUT_MS=
HAMDEE_OWNER_RATE_WINDOW_MS=
HAMDEE_OWNER_RATE_BOUNDS=
HAMDEE_OWNER_RATE_BACKOFF_MS=
# No recovery message destination, admin key or public signup switch is added.
